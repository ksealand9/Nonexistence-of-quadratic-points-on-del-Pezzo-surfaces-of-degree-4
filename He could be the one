Q := Rationals();
P<u0,u1,u2,u3,u4> := ProjectiveSpace(Q, 4);
R<x>:=PolynomialRing(Q);

magictest:=function(Q3,Q4)
    M3:=SymmetricMatrix(Q3);
    M4:=SymmetricMatrix(Q4);
    f := Determinant(ChangeRing(M3,R)+x*ChangeRing(M4,R));
    PrimesD:=[x[1]:x in Factorisation(Numerator(Discriminant(f)))];
    print PrimesD;
    print "Untested primes:", [p: p in PrimesD | p gt 200];
    X := Scheme(P, [Q3, Q4]);
    ELS:=&and[IsLocallySolvable(X,p): p in PrimesD cat [2,3]];
    [IsLocallySolvable(X,p): p in PrimesD cat [2,3]];
    if ELS eq true then
        pts:=PointSearch(X, 300 : OnlyOne := true);
        return ELS,pts;
    end if;
    return ELS;
end function;

Q3 := -5*u0^2 - 10*u0*u1 + 20*u1^2 + 5*u2^2 + 20*u2*u3 + 10*u3^2 + 10*u2*u4 + 75*u4^2;
Q4 := u0^2 - 2*u0*u1 + 2*u1^2 + u2^2 + 2*u3^2 - 5*u4^2;

Q3 := -u0^2 - 2*u0*u1 + 4*u1^2 + u2^2 + 4*u2*u3 + 2*u3^2 + 2*u2*u4 + 15*u4^2;
Q4 := u0^2 - 2*u0*u1 + 2*u1^2 + u2^2 + 2*u3^2 - 5*u4^2;

magictest(Q3,Q4);
