Q := Rationals();
P<u0,u1,u2,u3,u4> := ProjectiveSpace(Q, 4);
R<x>:=PolynomialRing(Q);

magictest:=function(Q3,Q4)
    M3:=SymmetricMatrix(Q3);
    M4:=SymmetricMatrix(Q4);
    f := Determinant(ChangeRing(M3,R)+x*ChangeRing(M4,R));
    PrimesD:=[x[1]:x in Factorisation(Numerator(Discriminant(f)))];
    print PrimesD;
    print "Untested primes:", [p: p in PrimesD | p gt 200];
    X := Scheme(P, [Q3, Q4]);
    ELS:=&and[IsLocallySolvable(X,p): p in PrimesD cat [2,3] | p le 200];
    [IsLocallySolvable(X,p): p in PrimesD cat [2,3] | p le 200];
    if ELS eq true then
        pts:=PointSearch(X, 100 : OnlyOne := true);
        return ELS,pts;
    end if;
    return ELS;
end function;

Q3 := -20*u0^2 - 20*u0*u1 + 60*u1^2 + 25*u2^2 - 60*u2*u3 + 10*u2*u4 + 45*u3^2 +
100*u3*u4 + 928325/401*u4^2;
Q4 := u0^2 + 4*u0*u1 + 5*u1^2 - 8*u2^2 + 6*u2*u3 + 40*u2*u4 - 9*u3^2 + 20*u3*u4
+ 20*u4^2;
magictest(Q3,Q4);
